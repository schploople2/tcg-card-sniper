{
  "name": "tcg-card-sniper",
  "version": "0.1.0",
  "private": true,
  "description": "Pokémon card deal-finder — monorepo",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently \"pnpm --filter server dev\" \"pnpm --filter client dev\"",
    "build": "pnpm --filter server build && pnpm --filter client build",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "changelog": "node scripts/changelog.mjs",
    "changelog:test": "node --test scripts/__tests__/changelog-format.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "prisma": "^5.14.0"
  }
}
