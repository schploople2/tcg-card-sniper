// Prisma schema — TCG Card Sniper
// Run `pnpm db:generate` after editing this file
// Run `pnpm db:migrate` to apply changes to your local DB

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum DealTier {
  HOT       // > 25% below market (after shipping)
  GOOD      // 10–25% below market
  FAIR      // 0–10% below market
  OVER      // above market price
  /// No market reference price available (e.g. alt-art on pokemontcg.io with no
  /// tcgplayer.prices and no scraped/cardmarket fallback). Listings are still
  /// surfaced — the user can browse — but no deal tier can be assigned.
  UNSCORED
}

enum ListingType {
  AUCTION
  FIXED_PRICE
}

/// More precise listing shape. The legacy `ListingType` only distinguished
/// AUCTION vs FIXED_PRICE; many eBay listings are *both* (Buy It Now plus
/// an auction price), and a separate "pure auction" (no Buy It Now option)
/// requires different UX — countdown timer becomes the headline, not the
/// price. Lets the UI surface them in a dedicated tab.
///   - AUCTION_ONLY:      currentBidPrice present, no Buy It Now
///   - BIN:               Buy It Now only, no auction
///   - BIN_PLUS_AUCTION:  Buy It Now AND auction running in parallel
enum ListingKind {
  AUCTION_ONLY
  BIN
  BIN_PLUS_AUCTION
}

/// Why an alert fired. Lets the UI / notifier present a distinct message
/// per kind without storing prose in the row.
///   - TARGET_HIT: a listing's totalCost fell at/below user-set targetPrice
///   - HOT_DEAL:   a listing was classified HOT by the deal-score engine
///                 (>=25% under adjusted market) regardless of any target
enum AlertKind {
  TARGET_HIT
  HOT_DEAL
  /// A1 — auto-OCR'd lot whose Vision-derived low-estimate is significantly
  /// higher than the asking price (currently: lowEstimate ≥ 2× listingPrice
  /// AND lotTier == HOT). References Alert.lotEbayItemId instead of cardId.
  LOT_HOT
  /// A2 — lot whose photos contain ≥$30 of cards whose names don't appear
  /// in the listing title (the "hidden gems in a generic-title bulk lot"
  /// signal). Fires independently of LOT_HOT — a lot can be both. Dedup
  /// is per (userId, lotEbayItemId, kind) like the other lot alerts.
  MISTITLED
  /// D2 — a new listing surfaced from a seller the user explicitly
  /// watches (WatchedSeller). References Alert.listingId like the
  /// card-tied kinds. Independent of tier — even a fairly-priced listing
  /// fires SELLER_LISTING because the signal is "this seller posted
  /// something new", not "this is a deal".
  SELLER_LISTING
}

// ─────────────────────────────────────────────────────────────────────────────
// User
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  /// Optional Discord webhook URL. When set, every alert (TARGET_HIT,
  /// HOT_DEAL) is also POSTed as an embed. Stored plaintext at the user's
  /// own trust level — webhook URLs are sensitive (anyone with the URL
  /// can post) but they live on the user's profile next to their email
  /// and password hash, so symmetric encryption would add complexity
  /// without changing the threat surface. GET responses redact to
  /// `…/last10chars` so the value can't leak via XSS to a third party.
  discordWebhookUrl String?

  watchedCards    WatchedCard[]
  alerts          Alert[]
  lotAnnotations  LotAnnotation[]
  ocrUsage        OcrUsage[]
  savedLotSearches SavedLotSearch[]
  savedLots        SavedLot[]
  watchedSellers  WatchedSeller[]
  pushSubscriptions PushSubscription[]
  collectionEntries CollectionEntry[]
  watchlistGroups   WatchlistGroup[]
}

// ─────────────────────────────────────────────────────────────────────────────
// PushSubscription — B2: per-device Web Push subscription endpoints.
// One row per (user, browser/device) — a user can subscribe from multiple
// devices and each gets its own row. The endpoint URL is unique per
// subscription and is the natural primary key for upserts; userId is denormed
// for fan-out queries.
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// SoldComp — C1: true sold-comparable listings scraped from eBay.
// One row per individual sold/completed listing. Used to surface "recently
// sold" panels and (future) replace tcgplayer market for deal scoring when
// ≥N comps exist. cardId is nullable so we can also cache ad-hoc query-based
// scrapes that aren't tied to a watched card.
// ─────────────────────────────────────────────────────────────────────────────

model SoldComp {
  id              String    @id @default(cuid())
  /// The card this comp is for. Nullable for query-keyed (cardless) caches.
  cardId          String?
  /// The keyword query that produced this scrape — lets us look up
  /// "did we already fetch comps for this exact query within the TTL?"
  /// without joining through cardId.
  query           String
  ebayItemId      String
  title           String
  /// Sold price as displayed on the page (the buyer's hammer, not incl shipping)
  soldPrice       Decimal   @db.Decimal(10, 2)
  shippingCost    Decimal?  @db.Decimal(10, 2)
  totalPrice      Decimal   @db.Decimal(10, 2)
  /// String key matching the rest of the codebase ("NM"/"LP"/"MP"/"HP"/"DMG"/"GRADED"/null)
  conditionGrade  String?
  /// C2 — Specific grader+score parsed from title when conditionGrade='GRADED'.
  /// Canonical labels: "PSA 10", "PSA 9", "BGS 9.5", "CGC 10", "SGC 9", etc.
  /// Null for raw rows or graded rows whose grade we couldn't parse.
  gradeLabel      String?
  /// True when the listing carried the "Best Offer accepted" badge — the
  /// sold price is then the offer, not the asking price. Distinct signal.
  acceptedOffer   Boolean   @default(false)
  soldAt          DateTime
  imageUrl        String?
  ebayUrl         String
  fetchedAt       DateTime  @default(now())

  card Card? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  /// Same listing can in theory be scraped under multiple queries; we
  /// dedupe by (query, ebayItemId) so re-fetching the same query doesn't
  /// duplicate rows.
  @@unique([query, ebayItemId])
  @@index([cardId, soldAt])
  @@index([cardId, gradeLabel])
  @@index([query, fetchedAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  /// The push service endpoint URL the browser gave us at subscribe time.
  /// Push services (FCM, APNs-via-Apple, Mozilla) rotate or revoke these;
  /// when web-push returns 410 we should DELETE the row.
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// WatchedSeller — D2: eBay seller usernames a user wants new-listing alerts for.
// Evaluated piggy-back during the existing refresh-listings cron: whenever a
// fresh listing's `seller` matches a WatchedSeller, fire SELLER_LISTING.
// ─────────────────────────────────────────────────────────────────────────────

model WatchedSeller {
  id              String    @id @default(cuid())
  userId          String
  /// eBay seller username, case-insensitive comparison at evaluation time.
  /// Stored as the user typed it for display, lowercased for matching.
  sellerName      String
  /// Optional friendly note ("the WOTC guy", "auctions for cheap").
  note            String?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sellerName])
  @@index([userId])
  @@index([sellerName])
}

// ─────────────────────────────────────────────────────────────────────────────
// SavedLotSearch — B4: persisted lot search queries that scope A1 alerts
// per-user. The hourly :45 cron re-runs each saved search against eBay so
// new matching lots land in the DB; A4's :15 sweep OCRs them; A1's
// evaluator fires LOT_HOT alerts only to the users whose saved search
// matches that lot's title (optionally filtered by lowEstimate floor or
// asking-price ceiling).
//
// Replaces the old "A1 fires globally to every user" v1 behavior — alerts
// are now opt-in via a save. Users with zero saves get no lot alerts.
// ─────────────────────────────────────────────────────────────────────────────

model SavedLotSearch {
  id              String    @id @default(cuid())
  userId          String
  /// Freetext query the user typed into the Lots search box (e.g.
  /// "charizard 1st edition lot"). Compared case-insensitively against
  /// Lot.title in matchUsersForLot — every space-separated token must
  /// appear somewhere in the title.
  query           String
  /// Optional alert floor — only fire when Lot.lowEstimate ≥ this value
  /// (overrides the global LOT_ALERT_MIN_LOW_USD env for this saved
  /// search only). Null = use the global default.
  minLowEstimate  Decimal?  @db.Decimal(10, 2)
  /// Optional alert ceiling — skip lots whose listingPrice exceeds this,
  /// useful for users who only care about lots in a particular price band.
  maxAskingPrice  Decimal?  @db.Decimal(10, 2)
  createdAt       DateTime  @default(now())
  /// Bumped each time the cron evaluates this search.
  lastEvaluatedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, query])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SavedLot — u8y: pinned lot listings for later viewing.
// One row per (userId, ebayItemId). Snapshots title / image / url /
// listingPrice at save time so the saved list still renders after the
// underlying Lot row evicts (30-min TTL).
// ─────────────────────────────────────────────────────────────────────────────

model SavedLot {
  id            String   @id @default(cuid())
  userId        String
  /// Canonical eBay item id form (e.g. "v1|306958101447|0") — same shape used by Lot.ebayItemId.
  ebayItemId    String
  // Snapshot fields persisted at save time:
  title         String
  imageUrl      String?
  ebayUrl       String
  listingPrice  Decimal  @db.Decimal(10, 2)
  /// Optional free-text note from the user ("waiting for end-of-auction snipe", etc.).
  note          String?

  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ebayItemId])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// WatchedCard — cards the user wants to track
// ─────────────────────────────────────────────────────────────────────────────

model WatchedCard {
  id           String   @id @default(cuid())
  userId       String
  /// pokemontcg.io card ID (e.g. "base1-4") — drives precise price lookups
  pokemonTcgId String
  cardName     String
  setName      String
  cardNumber   String?
  /// TCGPlayer variant key (e.g. "normal", "holofoil", "reverseHolofoil",
  /// "1stEditionHolofoil"). Determines which variant's market price drives
  /// the alert threshold AND the eBay search keyword qualifier.
  variant      String   @default("normal")
  /// Optional user-set target price (USD). When a refresh fetches a listing
  /// whose totalCost <= targetPrice, an Alert (kind = TARGET_HIT) is created.
  /// Null = no target; alerts only fire for HOT-tier deals.
  targetPrice  Decimal? @db.Decimal(10, 2)
  /// 4ke: user-defined grouping. null = "Ungrouped" bucket on the
  /// Watchlist page. onDelete: SetNull so deleting a group orphans its
  /// cards back to Ungrouped instead of nuking them.
  groupId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  group          WatchlistGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  listings       Listing[]
  priceCache     PriceCache?
  priceSnapshots PriceSnapshot[]
  alerts         Alert[]

  @@index([userId])
  @@index([userId, groupId])
}

// ─────────────────────────────────────────────────────────────────────────────
// WatchlistGroup — 4ke: user-defined buckets on the Watchlist page. One
// group per card via WatchedCard.groupId (null = Ungrouped). Unique name
// per user so the picker doesn't show two indistinguishable choices.
// sortOrder is a 0-based int the client can update via PATCH; default to
// creation order.
// ─────────────────────────────────────────────────────────────────────────────

model WatchlistGroup {
  id        String   @id @default(cuid())
  userId    String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards WatchedCard[]

  @@unique([userId, name])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Alert — a notification candidate fired when a listing crosses a user's
// target price OR when a listing scores HOT against adjusted market.
//
// Lifecycle:
//   1. Refresh job evaluates each fresh listing against the watched card's
//      targetPrice and dealTier, calling `evaluateListings()` in alerts.ts.
//   2. New rows are created with deliveredAt = null and readAt = null.
//   3. P4 (in-app notifications) will toggle readAt as the user views them.
//   4. A future P11 email-delivery job will toggle deliveredAt.
//
// Dedup: at-most one row per (cardId, listingId, kind). We never re-fire
// the same alert twice for the same listing, even if it remains a HOT deal
// across multiple refreshes.
// ─────────────────────────────────────────────────────────────────────────────

model Alert {
  id        String   @id @default(cuid())
  /// Denormalised — saves a join when surfacing alerts to a user.
  userId    String
  /// For TARGET_HIT / HOT_DEAL alerts (single-card watch matches). NULL for
  /// LOT_HOT — those reference lotEbayItemId instead. Exactly one of
  /// cardId / lotEbayItemId is set on every row; the application-layer
  /// alert services enforce this invariant.
  cardId    String?
  listingId String?
  kind      AlertKind

  /// A1 — references Lot.ebayItemId for LOT_HOT alerts. NULL for card-tied
  /// kinds. No FK to Lot; lots have a 30-min TTL and cascade-delete would
  /// erase alert history every time a lot rotates. UI joins lazily.
  lotEbayItemId String?

  /// When the in-app notification was marked read (P4). null = unread.
  readAt      DateTime?
  /// When (if ever) we shipped this alert via a delivery channel (email,
  /// push, etc.). null = not yet delivered. The Alert row itself is the
  /// in-app representation; deliveredAt tracks side-channels.
  deliveredAt DateTime?
  createdAt   DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  card    WatchedCard? @relation(fields: [cardId], references: [id], onDelete: Cascade)
  /// We don't FK to Listing — listings are short-lived (30-min TTL) and
  /// cascade-delete would erase alert history every time a listing rotates.
  /// Store the ebayItemId-derived id as plain text; UI joins lazily.

  @@unique([cardId, listingId, kind])
  /// Dedup lot alerts per-user — at most one LOT_HOT per (user, lot, kind),
  /// even if the lot's OCR is re-run.
  @@unique([userId, lotEbayItemId, kind])
  @@index([userId, readAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Listing — a single eBay listing fetched for a watched card
// ─────────────────────────────────────────────────────────────────────────────

model Listing {
  id         String @id @default(cuid())
  cardId     String
  /// eBay item ID. Unique *per watched card*, not globally — multiple users
  /// can each track the same eBay listing on their own watched-card row.
  ebayItemId String

  title    String
  imageUrl String?
  ebayUrl  String  // affiliate URL from itemAffiliateWebUrl

  /// Base listing price (before shipping)
  listingPrice Decimal @db.Decimal(10, 2)
  /// Shipping cost from eBay shippingOptions[0].shippingCost.value.
  /// NULL means free shipping — the deal engine treats it as $0.
  shippingCost Decimal? @db.Decimal(10, 2)
  /// listingPrice + (shippingCost ?? 0) — stored for fast sorting/filtering
  totalCost Decimal @db.Decimal(10, 2)

  /// NM (Near Mint) market price at fetch time. This is the canonical
  /// "full price" reference; dealScore compares against an adjusted version
  /// below. May be 0 when no price source has data (UNSCORED tier).
  marketPrice Decimal @db.Decimal(10, 2)
  /// Where the marketPrice came from: "tcgplayer" (pokemontcg.io tcgplayer.prices),
  /// "tcgplayer_scrape" (our scraping fallback), "cardmarket"
  /// (pokemontcg.io cardmarket.prices, EUR), or "none" (no source — UNSCORED).
  priceSource String?
  /// ISO 4217 currency of marketPrice. USD for tcgplayer sources, EUR for
  /// cardmarket. Null for legacy rows; UI assumes USD when null.
  priceCurrency String?
  /// marketPrice × condition multiplier (e.g. MP = 0.65×). This is the
  /// number the score and tier are calculated against — flagging an MP
  /// listing against full NM market produces false HOT alerts.
  adjustedMarketPrice Decimal? @db.Decimal(10, 2)
  /// Condition grade parsed from the listing title: NM | LP | MP | HP |
  /// DMG | GRADED | UNKNOWN. Drives the multiplier above.
  conditionGrade String?
  /// ((adjustedMarketPrice - totalCost) / adjustedMarketPrice) * 100,
  /// rounded to nearest int
  dealScore Int
  dealTier  DealTier

  listingType    ListingType
  /// More precise listing shape (AUCTION_ONLY / BIN / BIN_PLUS_AUCTION).
  /// Null on legacy rows fetched before P5 — UI treats null as BIN since
  /// pure-auction listings were previously dropped at fetch time.
  kind           ListingKind?
  /// eBay's coarse condition field ("Ungraded", "Used", etc.). Distinct from
  /// `conditionGrade` which is our title-parsed NM/LP/MP/HP/DMG/GRADED.
  condition      String?
  seller         String?
  sellerFeedback Float?

  /// Only set for AUCTION listings
  bids    Int?
  endTime DateTime?

  fetchedAt DateTime @default(now())
  /// Listings expire after 30 min — the cron job re-fetches after this
  expiresAt DateTime

  card WatchedCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, ebayItemId])
  @@index([cardId])
  @@index([dealTier, dealScore])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// PriceCache — TCGPlayer prices (via pokemontcg.io) cached per card for 6 hours
// ─────────────────────────────────────────────────────────────────────────────

model PriceCache {
  id     String @id @default(cuid())
  cardId String @unique

  /// Full TCGPlayer prices object from pokemontcg.io, keyed by variant name:
  ///   { "normal":   { low, mid, high, market, directLow },
  ///     "holofoil": { low, mid, high, market, directLow }, ... }
  /// All values are USD. Null when pokemontcg.io has no TCGPlayer data
  /// for the card (rare, but happens with very new releases).
  variants Json?
  /// Cardmarket aggregate prices (EUR) — single flat object, not per-variant.
  /// Cached alongside TCGPlayer so the fallback resolver doesn't need a
  /// separate fetch. Null when pokemontcg.io has no cardmarket data.
  cardmarketPrices Json?

  fetchedAt DateTime @default(now())
  /// Cache expires after 6 hours
  expiresAt DateTime

  card WatchedCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// TcgplayerScrapeCache — fallback prices scraped from TCGPlayer for cards
// where pokemontcg.io doesn't expose tcgplayer.prices (alt-arts, special
// illustration rares, very new releases). 24-hour TTL; gated behind the
// ENABLE_TCGPLAYER_SCRAPE feature flag.
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// Lot — an eBay listing that contains multiple cards bundled together.
//
// Lots are detected and valued by the lot pipeline (services/lotDetection,
// cardNameExtractor, lotValuation). They live in their own table rather than
// piggybacking on `Listing` because the data model is fundamentally different:
//   - Listings represent ONE printing; lots represent N printings.
//   - Lots don't have a `marketPrice` — they have a value RANGE
//     (lowEstimate / highEstimate) because parsed names are often ambiguous.
//
// The `parsedCards` JSON column captures everything the extractor found —
// names, quantities, and the candidate printings for each ambiguous name.
// The UI uses it to render the "Refine printings" picker without re-parsing
// (which would mean another DB round-trip + repeat trie scan).
//
// TTL: 30 minutes (same as Listing). The refresh cron re-parses on expiry.
// ─────────────────────────────────────────────────────────────────────────────

model Lot {
  id         String @id @default(cuid())
  ebayItemId String @unique

  title    String
  imageUrl String?
  ebayUrl  String

  /// Listing price before shipping (BIN or current bid for auction lots).
  listingPrice Decimal  @db.Decimal(10, 2)
  /// NULL = free shipping.
  shippingCost Decimal? @db.Decimal(10, 2)
  /// listingPrice + (shippingCost ?? 0) — convenience for sorting.
  totalCost    Decimal  @db.Decimal(10, 2)

  /// Conservative valuation: Σ (min market across candidate printings)
  /// for each parsed name × quantity. Drives lotScore + lotTier so HOT
  /// only fires when even the cheapest interpretation beats the listing.
  lowEstimate  Decimal  @db.Decimal(12, 2)
  /// Optimistic valuation: Σ (max market across candidates) × quantity.
  /// Displayed as the upper bound of the value range; not used for scoring.
  highEstimate Decimal  @db.Decimal(12, 2)

  /// ((lowEstimate - totalCost) / lowEstimate) × 100, rounded. Same shape as
  /// Listing.dealScore so tier logic carries over without translation.
  lotScore Int
  lotTier  DealTier

  /// Whether this lot is BIN, AUCTION_ONLY, or BIN_PLUS_AUCTION. Mirrors
  /// Listing.kind so the existing CountdownTimer / auction-tab UI patterns
  /// can be reused.
  kind ListingKind?

  /// Auction-only fields. NULL for BIN-only lots.
  bids    Int?
  endTime DateTime?

  /// Array<{ name, quantity, confidence, candidates: Array<{ cardId, setName,
  /// setReleaseDate, number, market, currency }> }>.
  /// Stored as JSON so the UI's "Refine printings" picker has everything it
  /// needs without re-parsing. Schema docs live in services/lotValuation.ts.
  parsedCards Json

  parsedAt  DateTime @default(now())
  /// 30-min TTL so the refresh cron knows when to re-fetch.
  expiresAt DateTime

  @@index([lotTier, lotScore])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// LotAnnotation — a user's manual analysis of a lot listing.
//
// The auto-extractor handles titles that name specific cards. Generic lots
// ("100 Card Mystery Pack") need humans: the user opens the listing's
// images, identifies cards visually, and adds them here. The lot's value
// range is re-computed by overlaying these onto the auto-parsed set.
//
// Keyed by (userId, ebayItemId) so each user maintains their own analysis
// of any eBay listing. Survives the 30-min Lot TTL so analyses persist
// across re-fetches (and re-appear next time the same listing surfaces).
//
// `addedCards` schema (Json): Array<{ cardId, quantity, note }>
//   - cardId    — pokemontcg.io id from the local Card table
//   - quantity  — defaults to 1
//   - note      — optional free-text the user attached ("foil version",
//                 "looks like LP", etc.)
// ─────────────────────────────────────────────────────────────────────────────

model LotAnnotation {
  id         String @id @default(cuid())
  userId     String
  /// eBay listing id we're annotating. Not a FK to Lot — annotations outlive
  /// the 30-min Lot TTL on purpose.
  ebayItemId String
  /// User-added cards (see schema above).
  addedCards Json   @default("[]")
  /// Free-form notes the user attached to the analysis.
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ebayItemId])
  @@index([ebayItemId])
}

// ─────────────────────────────────────────────────────────────────────────────
// LotImage — eBay-provided images for a lot listing, cached for the
// analyzer modal AND scaffolded for future OCR/vision pipelines.
//
// eBay's Browse API getItem endpoint returns up to ~12 images per listing
// (thumbnail, additional photos). We fetch lazily when a user opens the
// analyzer modal and persist them so subsequent opens are instant.
//
// Pre-OCR usage: just `imageUrl` for the gallery.
// Post-OCR usage (future): add `ocrText`, `detectedCardIds` columns and
// run an enrichment job against `ocrText IS NULL` rows.
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// OcrUsage — daily per-user spend ledger for Anthropic Vision calls.
//
// Vision is ~$0.003/image; left uncapped a single curious user could pull
// thousands of images a day. One row per (userId, UTC day). `imagesProcessed`
// counts only API-billed images (cache hits don't increment). `callsMade`
// counts /ocr-suggestions invocations regardless of cache outcome — useful
// for spotting hot-button users even when their spend is bounded.
//
// `OCR_DAILY_IMAGES_PER_USER` (env) is the soft cap; when exceeded the
// route returns 429. The cap is checked against `imagesProcessed` only,
// so re-running cached lots is always free.
// ─────────────────────────────────────────────────────────────────────────────

model OcrUsage {
  id              String   @id @default(cuid())
  userId          String
  /// UTC midnight of the day this row aggregates. Truncate at upsert time.
  day             DateTime @db.Date
  imagesProcessed Int      @default(0)
  callsMade       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
}

model LotImage {
  id         String   @id @default(cuid())
  ebayItemId String
  /// 0-indexed position in the eBay item's image array (0 = hero shot).
  position   Int
  imageUrl   String
  /// Reserved for the future vision pipeline. Null today.
  ocrText    String?
  fetchedAt  DateTime @default(now())

  @@unique([ebayItemId, position])
  @@index([ebayItemId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Card — local cache of the pokemontcg.io catalog (~17k cards).
//
// Why a local table? Live searches against api.pokemontcg.io require 3-5
// parallel Lucene queries with ~500ms latency each. Querying our own
// Postgres with a trigram index resolves in single-digit ms and supports
// the same fuzzy/partial/cross-era matching (Mew vs Mewtwo, Sylveon-EX
// vs Sylveon ex, "Radiant Collection" subset, etc.).
//
// Refreshed by jobs/syncCatalog.ts on a weekly cron. Prices are NOT stored
// here — those live in PriceCache (TCGPlayer) and TcgplayerScrapeCache
// (scrape fallback). This table is metadata only: name, set, number,
// rarity, images, and the list of TCGPlayer variants we can score against.
// ─────────────────────────────────────────────────────────────────────────────

model Card {
  /// pokemontcg.io id — same shape we already use everywhere ("base1-4", "sm11-79a").
  id     String @id
  name   String
  number String
  rarity String?

  setId          String
  setName        String
  setSeries      String
  setReleaseDate String?
  setTotal       Int?

  imageSmall String?
  imageLarge String?

  /// TCGPlayer variant keys present on this card ("holofoil", "normal",
  /// "reverseHolofoil", "1stEditionHolofoil", ...). Empty array when the
  /// card has no TCGPlayer pricing (alt-arts like sm11-79a). Stored as
  /// String[] so we can `?| array['holofoil']` filter cheaply.
  variants String[]

  /// Whether pokemontcg.io exposes cardmarket.prices for this card. Lets us
  /// quickly find "cards with at least *some* pricing source" without
  /// joining another table.
  hasCardmarket Boolean @default(false)

  /// Snapshot of TCGPlayer prices at sync time (USD). Keyed by variant —
  /// same shape as PriceCache.variants but living on the catalog row so
  /// lot-valuation can read prices without a PriceCache row existing.
  /// Stale-by-weekly (re-synced when syncCatalog runs); good enough for
  /// lot-level "rough value" estimates.
  tcgplayerPrices Json?
  /// Cardmarket aggregate prices (EUR), null when absent. Fallback for
  /// alt-arts that have no TCGPlayer data.
  cardmarketPrices Json?

  /// Indexed by sync time for "what's been refreshed lately" diagnostics.
  syncedAt DateTime @default(now())

  soldComps SoldComp[]
  collectionEntries CollectionEntry[]

  @@index([setId])
  @@index([number])
  // GIN/trigram indexes on `name` and `setName` are added in the SQL
  // migration — Prisma doesn't have first-class support for them.
}

// ─────────────────────────────────────────────────────────────────────────────
// PriceSnapshot — daily point-in-time record of a watched card's market
// price (from whichever source resolved at fetch time). Powers the real
// price-history chart in CardDetailDrawer, replacing the synthetic sparkline.
//
// Cardinality: one row per (cardId, variant) per day. The daily cron writes
// at 00:05 UTC and prunes rows older than 1 year as it goes.
// ─────────────────────────────────────────────────────────────────────────────

model PriceSnapshot {
  id      String   @id @default(cuid())
  cardId  String
  /// pokemontcg.io variant key the snapshot is for ("holofoil", "normal",
  /// "reverseHolofoil", etc.). Mirrors WatchedCard.variant at snapshot time.
  variant String
  /// "tcgplayer" | "tcgplayer_scrape" | "cardmarket" | "none". When "none",
  /// market is 0 — kept as a row so we can tell "we tried and found no price"
  /// apart from "we didn't try."
  source  String
  /// Market price in the source's native currency. Decimal(12,2) accommodates
  /// vintage Charizards trading near $200k without overflow.
  market  Decimal  @db.Decimal(12, 2)
  /// ISO 4217 currency. USD for tcgplayer sources, EUR for cardmarket.
  currency  String   @default("USD")
  takenAt   DateTime @default(now())

  card WatchedCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, takenAt])
  /// Belt-and-suspenders: one snapshot per card+variant per day. Date is
  /// coerced via the cron job (it always writes at 00:05 UTC) so this is
  /// effectively a daily uniqueness guarantee.
  @@index([takenAt])
}

model TcgplayerScrapeCache {
  id String @id @default(cuid())
  /// pokemontcg.io card id (e.g. "sm11-79a"). Not unique-by-card here because
  /// we also need to cache "miss" results (prices = null) to avoid hammering
  /// TCGPlayer on every refresh for a card that has no listing.
  pokemonTcgId String  @unique
  /// The TCGPlayer product URL we scraped (or attempted). Null when
  /// resolution failed (card not findable on TCGPlayer).
  productUrl   String?
  /// Parsed price data: { low, mid, high, market } in USD. Null on miss.
  prices       Json?
  currency     String   @default("USD")
  /// Distinguishes a real cache miss (TCGPlayer has no record) from a
  /// transient scrape failure (network, rate-limit, parse error).
  status       String   @default("ok") // "ok" | "not_found" | "scrape_error"
  fetchedAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// CollectionEntry — hpx: per-user "I own this card" marker for the
// /collection tracker (Radiant Collection from g1 + bw11 to start).
// Presence of a row = collected; absence = not collected. Tap-to-toggle
// upserts or deletes; we don't keep a soft-deleted history.
// ─────────────────────────────────────────────────────────────────────────────

model CollectionEntry {
  id          String   @id @default(cuid())
  userId      String
  cardId      String
  collectedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId])
}
